---
import { Image } from 'astro:assets';

interface Props {
  /** URL pública do .mp4 */
  src: string;
  /** URL da imagem de poster */
  poster: string;
  /** Título do vídeo */
  title: string;
  /** Descrição curta para o schema */
  description?: string;
  /** Data de upload ISO 8601 */
  uploadDate?: string;
  /** Duração ISO 8601 */
  duration?: string;
  /** Mostra controles nativos */
  controls?: boolean;
  class?: string;
}

const {
  src,
  poster,
  title,
  description = '',
  uploadDate,
  duration,
  controls = true,
  class: className,
} = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  contentUrl: src,
  thumbnailUrl: poster,
  ...(uploadDate && { uploadDate }),
  ...(duration && { duration }),
};
---

<div class:list={['video-wrap', className]}>
  <video
    class="video-wrap__player"
    poster={poster}
    preload="metadata"
    playsinline
    controls={controls}
    src={src}
    aria-label={title}
  >
    <source src={src} type="video/mp4" />
    Seu navegador não suporta vídeo HTML5.
  </video>
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .video-wrap {
    position: relative;
    background: #000;
    overflow: hidden;
    border-radius: inherit;
    aspect-ratio: 16 / 9;
    width: 100%;
  }
  .video-wrap__player {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
