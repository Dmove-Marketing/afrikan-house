---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  priority?: boolean;
  quality?: number;
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  width = 1200,
  height,
  priority = false,
  quality = 80,
  class: className,
  style,
} = Astro.props;

const isSvg = src.endsWith('.svg');

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const key = `/src/assets/images/${src}`;
let mod = isSvg ? null : images[key];

if (!isSvg && !mod) {
  const filename = src.includes('/') ? src.split('/').pop() : src;
  const foundKey = Object.keys(images).find(k => k.endsWith(`/${filename}`));
  if (foundKey) {
    mod = images[foundKey];
  } else {
    console.warn(`[Img] imagem não encontrada: ${key}`);
  }
}
---

{isSvg ? (
  <img
    src={src.startsWith('/') ? src : `/images/${src.includes('/') ? src.split('/').pop() : src}`}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    class={className}
    style={style}
  />
) : mod ? (
  <Image
    src={mod.default}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    quality={quality}
    class={className}
    style={style}
  />
) : (
  <img
    src=""
    alt={alt}
    width={width}
    height={height ?? undefined}
    class={className}
    style={style}
    data-placeholder={key}
    aria-hidden="true"
  />
)}
