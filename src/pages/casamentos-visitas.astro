<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.elementor-image-carousel-wrapper').forEach(function(el) {
      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 0,
        loop: true,
        navigation: {
          nextEl: el.querySelector('.elementor-swiper-button-next'),
          prevEl: el.querySelector('.elementor-swiper-button-prev'),
        },
        pagination: {
          el: el.querySelector('.swiper-pagination'),
          clickable: true,
        },
        breakpoints: {
          640: { slidesPerView: 2, spaceBetween: 0 },
          1024: { slidesPerView: 3, spaceBetween: 0 },
          1200: { slidesPerView: 4, spaceBetween: 0 }
        }
      });
    });

    document.querySelectorAll('.elementor-main-swiper, .elementor-testimonial-carousel').forEach(function(el) {
      const container = el.closest('.elementor-widget') || el.parentElement;
      new Swiper(el, {
        slidesPerView: 2,
        spaceBetween: 24,
        speed: 1200,
        loop: true,
        navigation: {
          nextEl: container.querySelector('.elementor-swiper-button-next'),
          prevEl: container.querySelector('.elementor-swiper-button-prev'),
        },
        pagination: {
          el: container.querySelector('.swiper-pagination'),
          clickable: true,
        },
        breakpoints: {
          0: { slidesPerView: 1, spaceBetween: 16 },
          768: { slidesPerView: 2, spaceBetween: 24 }
        }
      });
    });

    document.querySelectorAll('.swiper').forEach(function(el) {
      if (!el.swiper) {
        const container = el.closest('.elementor-widget') || el.parentElement;
        new Swiper(el, {
          slidesPerView: 1,
          loop: true,
          navigation: {
            nextEl: container.querySelector('.elementor-swiper-button-next, .swiper-button-next'),
            prevEl: container.querySelector('.elementor-swiper-button-prev, .swiper-button-prev'),
          }
        });
      }
    });
  });
</script>
