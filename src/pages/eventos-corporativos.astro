<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script is:inline>
  function loadDataBg() {
    document.querySelectorAll('[data-bg]').forEach(function(el) {
      const bg = el.getAttribute('data-bg');
      if (bg) {
        el.style.backgroundImage = 'url("' + bg + '")';
        el.style.backgroundSize = 'cover';
        el.style.backgroundPosition = 'center';
      }
    });
  }

  function initBackgroundSlideshows() {
    const slideshowImages = [
      '/images/eventos-corporativos/6-1-e1720706720262.jpg',
      '/images/eventos-corporativos/Bangalo-3.jpg',
      '/images/eventos-corporativos/Mesa-de-doces-2.jpg'
    ];

    const containers = document.querySelectorAll('.elementor-element-519ae90, .elementor-element-43f2851, .elementor-element-8632fb9');

    containers.forEach(function(container) {
      if (container.querySelector('.hero-bg-slideshow')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'hero-bg-slideshow';

      slideshowImages.forEach(function(imgUrl, idx) {
        const slide = document.createElement('div');
        slide.className = 'hero-bg-slide' + (idx === 0 ? ' active' : '');
        slide.style.backgroundImage = 'url("' + imgUrl + '")';
        wrapper.appendChild(slide);
      });

      container.prepend(wrapper);

      let currentIdx = 0;
      const slides = wrapper.querySelectorAll('.hero-bg-slide');

      setInterval(function() {
        slides[currentIdx].classList.remove('active');
        currentIdx = (currentIdx + 1) % slides.length;
        slides[currentIdx].classList.add('active');
      }, 4000);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      loadDataBg();
      initBackgroundSlideshows();
    });
  } else {
    loadDataBg();
    initBackgroundSlideshows();
  }

  document.addEventListener('DOMContentLoaded', function() {
    loadDataBg();
    initBackgroundSlideshows();

    document.querySelectorAll('.elementor-image-carousel-wrapper').forEach(function(el) {
      new Swiper(el, {
        slidesPerView: 5,
        spaceBetween: 8,
        loop: true,
        autoplay: { delay: 2500, disableOnInteraction: false },
        navigation: {
          nextEl: el.querySelector('.elementor-swiper-button-next'),
          prevEl: el.querySelector('.elementor-swiper-button-prev'),
        },
        pagination: {
          el: el.querySelector('.swiper-pagination'),
          clickable: true,
        },
        breakpoints: {
          0: { slidesPerView: 2, spaceBetween: 6 },
          640: { slidesPerView: 3, spaceBetween: 8 },
          1024: { slidesPerView: 5, spaceBetween: 8 }
        }
      });
    });

    document.querySelectorAll('.elementor-main-swiper, .elementor-testimonial-carousel').forEach(function(el) {
      const container = el.closest('.elementor-widget') || el.parentElement;
      new Swiper(el, {
        slidesPerView: 1,
        spaceBetween: 0,
        speed: 1000,
        loop: true,
        navigation: {
          nextEl: container.querySelector('.elementor-swiper-button-next'),
          prevEl: container.querySelector('.elementor-swiper-button-prev'),
        },
        pagination: {
          el: container.querySelector('.swiper-pagination'),
          clickable: true,
        },
        breakpoints: {
          0: { slidesPerView: 1, spaceBetween: 0 },
          768: { slidesPerView: 1, spaceBetween: 0 }
        }
      });
    });


    document.querySelectorAll('.swiper').forEach(function(el) {
      if (!el.swiper) {
        const container = el.closest('.elementor-widget') || el.parentElement;
        new Swiper(el, {
          slidesPerView: 1,
          loop: true,
          navigation: {
            nextEl: container.querySelector('.elementor-swiper-button-next, .swiper-button-next'),
            prevEl: container.querySelector('.elementor-swiper-button-prev, .swiper-button-prev'),
          }
        });
      }
    });
  });
</script>
