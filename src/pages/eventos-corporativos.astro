---
// Gerado a partir de: eventos-corporativos.html
import { Fragment } from 'astro/jsx-runtime';
import Base from '../layouts/Base.astro';
import config from '../../config.json';
import Img from '../components/ui/Img.astro';
import '../styles/eventos-corporativos.css';
---

<!-- ⚠️ Componentes para revisar após scaffold:
  - Carousel/Swiper — considere componente com lazy-load otimizado
-->
<Base
  title="Corporativo &#8211; Afrikan House"
  description="Eventos corporativos de alto padrão no Afrikan House. Grandes empresas contam com nossa experiência e estrutura em São Paulo. Solicite um orçamento."
  ogImage="/images/og-eventos-corporativos.jpg"
  canonical="https://eventos.afrikanhouse.com.br/eventos-corporativos/"
  whatsAppMessage="Olá! 🏢 Quer realizar seu evento corporativo no Afrikan House?\nPreencha as informações abaixo e nossa equipe entrará em contato pelo WhatsApp."
  whatsAppStep1Fields={[
    {
      name: 'empresa',
      type: 'text',
      label: 'Empresa',
      placeholder: 'Nome da sua empresa',
      required: true,
    },
    {
      name: 'tipo',
      type: 'select',
      label: 'Tipo de evento',
      required: true,
      options: [
        { value: '', label: 'Selecione o tipo de evento', disabled: true, selected: true },
        { value: 'Casamento', label: 'Casamento' },
        { value: 'Corporativo', label: 'Corporativo' },
        { value: 'Debutante', label: 'Debutante' },
        { value: 'Aniversário', label: 'Aniversário' },
        { value: 'Bodas', label: 'Bodas' },
        { value: 'Bar/bat mitzvah', label: 'Bar/bat mitzvah' },
        { value: 'Formatura', label: 'Formatura' },
        { value: 'Outro', label: 'Outro' },
      ],
    },
    {
      name: 'data',
      type: 'text',
      label: 'Data pretendida para o evento',
      placeholder: 'Ex: 15/11/2026',
      required: true,
    },
    {
      name: 'convidados',
      type: 'number',
      label: 'Número de convidados aproximado',
      placeholder: 'Ex: 100',
      required: true,
    },
    {
      name: 'etapa',
      type: 'select',
      label: 'Etapa do planejamento',
      required: true,
      options: [
        { value: '', label: 'Em qual etapa você está hoje?', disabled: true, selected: true },
        { value: 'Estou iniciando as pesquisas, sem visitas realizadas', label: 'Iniciando pesquisas' },
        { value: 'Já estou visitando espaços e pretendo definir em até 90 dias', label: 'Visitando espaços (até 90 dias)' },
        { value: 'Já visitei algumas opções e quero definir o espaço em até 30 dias', label: 'Pronto para decidir (até 30 dias)' },
      ],
    },
    {
      name: 'budget',
      type: 'select',
      label: 'Budget',
      required: true,
      options: [
        { value: '', label: 'Qual o investimento planejado?', disabled: true, selected: true },
        { value: 'Até R$ 70 mil', label: 'Até R$ 70 mil' },
        { value: 'De R$ 70 mil a R$ 90 mil', label: 'De R$ 70 mil a R$ 90 mil' },
        { value: 'De R$ 90 mil a R$ 120 mil', label: 'De R$ 90 mil a R$ 120 mil' },
        { value: 'De R$ 120 mil a R$ 150 mil', label: 'De R$ 120 mil a R$ 150 mil' },
        { value: 'Acima de R$ 150 mil', label: 'Acima de R$ 150 mil' },
      ],
    },
  ]}
>
<Fragment slot="head">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
</Fragment>
