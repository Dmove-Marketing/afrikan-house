<script>
  // Envio no formato legado do Elementor (application/x-www-form-urlencoded,
  // chaves = texto do <label> de cada campo) — é o formato que o workflow n8n
  // "afrikan-cadastro-manual" já espera receber.
  function initCadastroManualForm() {
    const form = document.getElementById('cadastro_manual');
    if (!form) return;

    const submitUrl = form.dataset.submitUrl;
    const redirectUrl = form.dataset.redirect;
    const project = form.dataset.project || window.location.hostname;

    if (!submitUrl) {
      console.warn('[CadastroManual] Formulário sem URL de webhook (data-submit-url).');
      return;
    }

    const phoneInput = form.querySelector('[name="form_fields[telefone]"]');
    if (phoneInput) {
      phoneInput.addEventListener('input', () => phoneInput.setCustomValidity(''));
    }

    let started = false;
    form.addEventListener('focusin', () => {
      if (!started) {
        started = true;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_start', form_id: 'cadastro-manual', project });
      }
    });

    // O botão é type="button" (não type="submit") de propósito: sem evento submit nativo,
    // o listener de captura do GTM ("Form Submission" automático) não tem o que interceptar,
    // então não dispara gtm.formSubmit em cliques que falham na validação.
    const submitBtn = form.querySelector('button');
    let isSubmitting = false;

    async function handleSubmit() {
      if (isSubmitting) return;

      const honeypot = form.querySelector('[name="website"]');
      if (honeypot && honeypot.value) return;

      if (phoneInput) {
        const digits = phoneInput.value.replace(/\D/g, '');
        phoneInput.setCustomValidity(
          digits.length > 0 && digits.length < 10 ? 'Informe um telefone válido com DDD (mínimo 10 dígitos).' : ''
        );
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      isSubmitting = true;
      const originalText = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Enviando...';
      }

      // Chave de cada campo = texto do <label> associado (com os ":" originais do Elementor),
      // exatamente como o n8n espera ("Nome:", "Telefone:", "Selecione o tipo de evento:", etc.)
      const payload = new URLSearchParams();
      form.querySelectorAll('[name^="form_fields["]').forEach((field) => {
        const label = form.querySelector('label[for="' + field.id + '"]');
        const key = label ? label.textContent.trim() : field.name;
        payload.set(key, field.value);
      });

      const now = new Date();
      payload.set('Data', now.toLocaleDateString('pt-BR'));
      payload.set('Horário', now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }));
      payload.set('URL da página', window.location.href);
      payload.set('Agente de usuário', navigator.userAgent);
      payload.set('IP remoto', '');
      payload.set('Desenvolvido por', 'Dmove');

      const formIdField = form.querySelector('[name="form_id"]');
      payload.set('form_id', formIdField ? formIdField.value : '');
      payload.set('form_name', form.name || '');

      try {
        const res = await fetch(submitUrl, { method: 'POST', body: payload });
        if (!res.ok) throw new Error('http_' + res.status);

        let json = {};
        try { json = await res.json(); } catch (err) {}

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_submit', form_id: 'cadastro-manual', project });

        const redir = redirectUrl || json.redirect;
        if (redir) {
          window.location.href = redir;
          return;
        }

        form.innerHTML = `
          <div style="text-align:center;padding:2rem;">
            <div style="width:56px;height:56px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;background:var(--color-primary,#2563eb);border-radius:50%;color:white;">✓</div>
            <h3 style="font-size:1.15rem;font-weight:600;margin-bottom:4px;">Enviado com sucesso!</h3>
            <p style="color:#666;font-size:0.9rem;">Em breve entraremos em contato.</p>
          </div>`;
      } catch (err) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'form_error', form_id: 'cadastro-manual', error: err.message });
        alert('Erro ao enviar o formulário. Tente novamente mais tarde.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalText;
        }
      } finally {
        isSubmitting = false;
      }
    }

    submitBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      handleSubmit();
    });

    form.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      const target = e.target;
      if (target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;
      e.preventDefault();
      handleSubmit();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCadastroManualForm);
  } else {
    initCadastroManualForm();
  }
</script>
<script>
  import '../scripts/cadastro-manual.js';
</script>
